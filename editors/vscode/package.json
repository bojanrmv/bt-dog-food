{
  "name": "dog-food",
  "displayName": "Dog Food",
  "description": "Complexity, CRAP, duplication and mutation testing from a side bar and a dashboard, and complexity above every function (C#, TypeScript/JavaScript, Rust). Runs the dgf command line tool.",
  "version": "0.0.0",
  "publisher": "dog-food",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": { "type": "git", "url": "https://github.com/bojanrmv/bt-dog-food" },
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Linters", "Visualization", "Testing"],
  "main": "./extension.js",
  "scripts": { "test": "node --test" },
  "activationEvents": [
    "onLanguage:csharp",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:rust"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [{ "id": "dogFood", "title": "Dog Food", "icon": "media/dgf.svg" }]
    },
    "views": {
      "dogFood": [{ "id": "dogFood.view", "name": "Analyses" }]
    },
    "commands": [
      { "command": "dogFood.run", "title": "Run Analysis", "category": "Dog Food", "icon": "$(play)" },
      { "command": "dogFood.runAll", "title": "Run Complexity, Changes and Duplication", "category": "Dog Food", "icon": "$(run-all)" },
      { "command": "dogFood.stop", "title": "Stop", "category": "Dog Food", "icon": "$(debug-stop)" },
      { "command": "dogFood.dashboard", "title": "Open Dashboard", "category": "Dog Food", "icon": "$(graph)" },
      { "command": "dogFood.chooseScope", "title": "Choose What to Analyze", "category": "Dog Food" },
      { "command": "dogFood.analyzeFile", "title": "Analyze Current File", "category": "Dog Food" },
      { "command": "dogFood.complexityOf", "title": "Complexity", "category": "Dog Food" },
      { "command": "dogFood.duplicationOf", "title": "Duplication", "category": "Dog Food" },
      { "command": "dogFood.mutationOf", "title": "Mutation Tests", "category": "Dog Food" }
    ],
    "submenus": [{ "id": "dogFood.explorer", "label": "Dog Food" }],
    "menus": {
      "view/title": [
        { "command": "dogFood.runAll", "when": "view == dogFood.view", "group": "navigation@1" },
        { "command": "dogFood.dashboard", "when": "view == dogFood.view", "group": "navigation@2" }
      ],
      "view/item/context": [
        { "command": "dogFood.run", "when": "view == dogFood.view && viewItem == dogFood.idle", "group": "inline@1" },
        { "command": "dogFood.stop", "when": "view == dogFood.view && viewItem == dogFood.running", "group": "inline@1" },
        { "command": "dogFood.dashboard", "when": "view == dogFood.view && viewItem =~ /^dogFood\\./", "group": "inline@2" }
      ],
      "explorer/context": [{ "submenu": "dogFood.explorer", "group": "z_dogFood" }],
      "dogFood.explorer": [
        { "command": "dogFood.complexityOf", "group": "1@1" },
        { "command": "dogFood.duplicationOf", "group": "1@2" },
        { "command": "dogFood.mutationOf", "group": "1@3" }
      ],
      "commandPalette": [
        { "command": "dogFood.complexityOf", "when": "false" },
        { "command": "dogFood.duplicationOf", "when": "false" },
        { "command": "dogFood.mutationOf", "when": "false" }
      ]
    },
    "configuration": {
      "title": "Dog Food",
      "properties": {
        "dogFood.path": {
          "type": "string",
          "default": "dgf",
          "description": "The dgf executable. Install it with `dotnet tool install -g dgf`."
        },
        "dogFood.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show the scores above each function."
        },
        "dogFood.duplicationLens": {
          "type": "boolean",
          "default": true,
          "description": "Show above a function where its code is duplicated. Copies are looked for in the whole workspace folder, when it is opened and when a source file changes."
        },
        "dogFood.codeLensMinimum": {
          "type": "number",
          "default": 1,
          "description": "Only show scores above functions with at least this cyclomatic complexity."
        }
      }
    }
  }
}
